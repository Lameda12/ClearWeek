CLEARWEEK_MODE=demo
# Private mode only. Set these in .env.local or the deployment environment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
CLEARWEEK_OWNER_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODE=free
GEMINI_PAID_CAP_VERIFIED=false

# Optional, only for the one-call hosted smoke test.
CLEARWEEK_SMOKE_FREE_TIER_CONFIRMED=false
CLEARWEEK_SMOKE_EMAIL=
CLEARWEEK_SMOKE_PASSWORD=

# Optional schedule-text extraction preview. Default off. Never used on Vercel for "local".
#   sample: fixed, labelled illustration for the built-in text. No model, no network. Safe on a public demo.
#   local:  calls the loopback service in local-extractor/. Needs CLEARWEEK_MODE=private (owner sign-in) or the
#           explicit unauthenticated opt-in below. Refused when VERCEL is set.
CLEARWEEK_EXTRACTION=off
CLEARWEEK_EXTRACTOR_URL=http://127.0.0.1:8765
CLEARWEEK_EXTRACTOR_TIMEOUT_MS=20000
CLEARWEEK_EXTRACTION_MAX_CHARS=600
CLEARWEEK_EXTRACTION_UNAUTHENTICATED_LOCAL=false
